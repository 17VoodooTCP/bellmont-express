# Neon (or any PostgreSQL) connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct, non-pooled connection used by Prisma migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
# At least 32 random characters in production; the server refuses to start otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"
PORT=5000
# Optional: extra allowed CORS origins, comma-separated
CLIENT_URL=""
# Optional: provision one admin account at startup
ADMIN_NAME="Bellmont Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-16-character-password"
# Optional: Cloudflare Turnstile secret key. Unset = captcha off.
# Pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the frontend (Vercel).
# Test keys: 1x0000000000000000000000000000000AA (always passes),
#            2x0000000000000000000000000000000AA (always fails).
TURNSTILE_SECRET_KEY=""
