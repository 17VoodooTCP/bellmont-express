/* Prisma 7: the client is generated into src/ (not node_modules) as
   CommonJS, which is what the NestJS build emits. It is rebuilt by
   `prisma generate` on every deploy and is not committed. */
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

/* Connection strings live outside the schema now: the CLI reads
   prisma.config.ts (direct URL, for migrations) and the app passes the
   pooled URL to its driver adapter (src/prisma/prisma.service.ts). */
datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum ShipmentStatus {
  pending
  picked_up
  in_transit
  out_for_delivery
  delivered
  on_hold
}

enum ChatStatus {
  bot
  human
  closed
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(user)
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments     Shipment[]
  requests      ShipmentRequest[]
  documents     Document[]
  notifications Notification[]
}

/// A customer's booking. Nothing reaches the live shipment table until an
/// admin approves it; approval issues the tracking number.
model ShipmentRequest {
  id              String        @id @default(cuid())
  /// Human reference quoted in support, e.g. BR-261015-K7Q2.
  reference       String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          RequestStatus @default(pending)
  /// standard | express | priority
  serviceLevel    String        @default("standard")
  senderName      String
  senderPhone     String?
  senderAddress   String
  originCity      String
  receiverName    String
  receiverPhone   String?
  receiverAddress String
  destinationCity String
  packageType     String
  weight          Float?
  dimensions      String?
  declaredValue   Float?
  contents        String?
  pickupDate      DateTime?
  notes           String?
  /// Admin's reason on rejection, or a note to the customer on approval.
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedBy      String?
  shipmentId      String?       @unique
  shipment        Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// A document sent to a customer's inbox. `payload` is a snapshot of the data
/// the document is rendered from (for a receipt, the shipment at send time),
/// so the customer always sees what was sent, and the page renders it with
/// the same escaped generator the admin used — no stored HTML.
model Document {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  /// receipt (more kinds later: invoice, letter)
  kind       String
  title      String
  message    String?
  payload    Json
  sentBy     String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// In-app notification. userId null means it is for the admin team.
model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @default("")
  /// Where clicking it takes you, e.g. /account/documents/abc
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Shipment {
  id                      String         @id @default(cuid())
  trackingId              String         @unique
  senderName              String
  senderAddress           String?
  receiverName            String
  receiverAddress         String?
  weight                  Float?
  packageType             String?
  status                  ShipmentStatus @default(pending)
  /// { city, lat, lng }
  origin                  Json
  destination             Json
  currentLocation         Json
  /// [{ status, location, description, timestamp }]
  timeline                Json           @default("[]")
  /// [{ amount, description, type, paid, createdAt }]
  invoices                Json           @default("[]")
  estimatedDelivery       DateTime?
  holdReason              String?
  delayReason             String?
  delayDescription        String?
  customsIntercepted      Boolean        @default(false)
  borderClearanceEligible Boolean        @default(false)
  customsNotes            String?
  /// The customer account this shipment belongs to, if any.
  ownerId                 String?
  owner                   User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  request                 ShipmentRequest?
  documents               Document[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([status])
  @@index([ownerId])
}

model ChatSession {
  id        String     @id @default(cuid())
  sessionId String     @unique
  userName  String     @default("Website Visitor")
  agentName String?
  status    ChatStatus @default(bot)
  /// bot conversation state, e.g. { state: "greeting" }
  context   Json       @default("{\"state\":\"greeting\"}")
  messages  Message[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Message {
  id           String      @id @default(cuid())
  session      ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sessionId    String
  sender       String
  message      String
  /// [{ label, value }]
  quickActions Json        @default("[]")
  timestamp    DateTime    @default(now())

  @@index([sessionId, timestamp])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  role      String
  stars     Int      @default(5)
  avatar    String   @default("")
  quote     String
  /// Short result chips shown on the card, e.g. "-25% freight spend".
  metrics   String[] @default([])
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// CMS: editable content blocks keyed by section slug (Phase 3 admin UI)
model CmsBlock {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

model LetterDraft {
  id               String   @id @default(cuid())
  title            String
  recipientName    String
  recipientAddress String   @default("")
  subject          String   @default("")
  body             String   @default("")
  signerName       String   @default("")
  signerTitle      String   @default("")
  department       String   @default("Operations")
  classification   String   @default("Private & Confidential")
  reference        String
  savedBy          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([updatedAt])
}

model Executive {
  id         String   @id @default(cuid())
  name       String
  title      String
  department String
  prefix     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([isActive])
}

model IssuedLetter {
  id             String   @id @default(cuid())
  reference      String   @unique
  verificationId String
  recipientName  String
  subject        String   @default("")
  department     String
  classification String
  signerName     String
  signerTitle    String   @default("")
  authorizationId String  @default("")
  issuedOn       String
  status         String   @default("ACTIVE")
  statusReason   String?
  fingerprint    String   @default("")
  generatedAt    DateTime @default(now())
  lastVerifiedAt DateTime?
  verifyCount    Int      @default(0)
  issuedBy       String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
